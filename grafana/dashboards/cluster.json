            "type": "grafana-postgresql-datasource",
            "uid": "hpc-timescale"
          },
          "rawSql": "SELECT bucket AT TIME ZONE 'UTC' AS \"time\", \"Reported CPU %\" FROM (SELECT time_bucket_gapfill('${bucket}'::interval, \"timestamp\") AS bucket, avg(cpu_percent) AS \"Reported CPU %\" FROM public.cluster_snapshots WHERE $__timeFilter(\"timestamp\") GROUP BY 1) series ORDER BY 1",
